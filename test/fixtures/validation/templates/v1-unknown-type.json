{
  "Resources": {
    "Widget": {
      "Type": "Custom::Widget",
      "Properties": {
        "ServiceToken": { "Fn::GetAtt": ["Func", "Arn"] },
        "anything_at_all": true
      }
    },
    "Func": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "Code": { "ZipFile": "print 1" },
        "Handler": "index.handler",
        "Role": { "Fn::GetAtt": ["Role", "Arn"] },
        "Runtime": "ruby40"
      }
    },
    "Role": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": { "Version": "2012-10-17" }
      }
    }
  }
}
