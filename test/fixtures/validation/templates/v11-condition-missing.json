{
  "Parameters": {
    "Stage": { "Type": "String" }
  },
  "Conditions": {
    "IsProd": { "Fn::Equals": [{ "Ref": "Stage" }, "prod"] }
  },
  "Resources": {
    "Bucket": {
      "Type": "AWS::S3::Bucket",
      "Condition": "NotDeclared",
      "Properties": {
        "BucketName": { "Fn::If": ["AlsoNotDeclared", "a", "b"] }
      }
    }
  },
  "Outputs": {
    "Name": {
      "Condition": "ThirdNotDeclared",
      "Value": "x"
    }
  }
}
